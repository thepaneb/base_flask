# Copie para .env (não commite o .env) ou exporte as variáveis.
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
# Produção: aponte para um volume/persistente, ex.:
# DATABASE_URL=sqlite:////data/base_flask.db
DATABASE_URL=sqlite:///base_flask.db
# Produção: troque por um segredo forte (>=32 chars) e não commite.
JWT_SECRET_KEY=dev-only-change-me
# Rate limiting: ex. "200 per hour"; Redis em produção (CACHE_REDIS_URL).
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per hour
# Cache: SimpleCache local; RedisCache em produção (compose já sobe o redis).
CACHE_TYPE=SimpleCache
# CACHE_REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TIMEOUT=60
